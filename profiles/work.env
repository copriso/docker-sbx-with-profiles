# profiles/work.env — company account sandbox
#
# Sourced by sbx-up.sh. Plain bash, so anything you can compute you can use.

AGENT="claude"
SANDBOX_NAME="work"

# ---------------------------------------------------------------- filesystem --
# WORKSPACE is the only host directory shared into the VM, in both directions.
# Point it at a scratch dir if you want the repo to live purely inside the
# sandbox (see CLONE_* below) and nothing of yours to be reachable.
WORKSPACE="$HOME/sbx/work"

# Anything your sbx version supports that this script does not model directly.
# Check `sbx create --help` for what is available in your build.
EXTRA_CREATE_ARGS=()
# EXTRA_CREATE_ARGS=(--clone)

# Optional kit: applied at creation time, so its files exist at first boot.
# Kits are the right place for team-wide policy + MCP defaults.
# KIT_DIR="kits/work"

# ------------------------------------------------------------------- network --
# Uncomment to start from deny-all rather than the default policy.
# POLICY_INIT="deny-all"

ALLOW_DOMAINS=(
  api.anthropic.com
  github.com
  codeload.github.com
  registry.npmjs.org
  pypi.org
  files.pythonhosted.org
  # internal services
  # artifacts.corp.example.com
  # gitlab.corp.example.com
)

# ------------------------------------------------------------------- secrets --
# Global secrets are injected at creation time and cannot be added afterwards,
# so these are only checked and warned about, never set.
REQUIRED_GLOBAL_SECRETS=()

# Sandbox-scoped secrets: applied immediately, override the global value, and
# stay confined to this sandbox. Format: "service=command producing the value".
SANDBOX_SECRETS=(
  "github=gh auth token"
)

# Experimental. Format: "ENV_VAR|host|command producing the value".
# Useful for MCP servers that authenticate with a plain API key, and for
# pinning a long-lived Claude token generated with:
#   CLAUDE_CONFIG_DIR=~/.claude-company claude setup-token
CUSTOM_SECRETS=(
  # "CLAUDE_CODE_OAUTH_TOKEN|api.anthropic.com|security find-generic-password -s sbx-work-claude -w"
  # "SENTRY_TOKEN|sentry.io|pass show work/sentry"
)

# ----------------------------------------------------------------------- MCP --
MCP_FILE="work.mcp.json"

# ---------------------------------------------------------------------- repo --
# Cloned inside the VM. Leave CLONE_DEST empty and it lands in $HOME/repos/<name>
# as resolved inside the sandbox, i.e. never on your host.
CLONE_REPO="git@github.com:my-company/main-service.git"
CLONE_DEST=""
CLONE_DEPTH="1"
CLONE_BRANCH=""

# ---------------------------------------------------------------------- hook --
# Runs after everything above, before the agent is attached. sbx_exec runs a
# command inside the VM.
post_create() {
  # Copy in a global CLAUDE.md, since the host's ~/.claude is not mounted:
  # sbx_exec sh -c 'mkdir -p "$HOME/.claude"'
  # cat ~/.claude-company/CLAUDE.md | sbx_exec sh -c 'cat > "$HOME/.claude/CLAUDE.md"'

  # Install extra tooling:
  # sbx_exec sudo apt-get install -y ripgrep

  # Configure git identity for the work account:
  sbx_exec git config --global user.email "robert@my-company.example"
  sbx_exec git config --global user.name  "Robert"
}
