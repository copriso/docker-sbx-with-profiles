# profiles/private.env — personal account sandbox

AGENT="claude"
SANDBOX_NAME="private"

WORKSPACE="$HOME/sbx/private"
EXTRA_CREATE_ARGS=()

# POLICY_INIT="deny-all"
ALLOW_DOMAINS=(
  api.anthropic.com
  github.com
  codeload.github.com
  registry.npmjs.org
  # home lab
  # ha.local
)

REQUIRED_GLOBAL_SECRETS=()
SANDBOX_SECRETS=(
  "github=gh auth token"
)
CUSTOM_SECRETS=()

MCP_FILE="private.mcp.json"

CLONE_REPO=""          # pass one ad hoc: ./sbx-up.sh private --repo <url>
CLONE_DEST=""
CLONE_DEPTH="1"
CLONE_BRANCH=""

post_create() {
  sbx_exec git config --global user.email "robert@personal.example"
  sbx_exec git config --global user.name  "Robert"
}
